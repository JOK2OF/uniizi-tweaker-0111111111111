<UserControl x:Class="UniiziTweaker01.Views.PendingModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageStyle}">
    <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource TitleText}"/>
        <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Not implemented yet" Foreground="{StaticResource WarnBrush}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}" FontSize="13" Margin="0,8,0,0"/>
                <TextBlock Margin="0,12,0,0" Style="{StaticResource CaptionText}">
                    <Run Text="Planned build step: "/><Run Text="{Binding PlannedStep, Mode=OneWay}" Foreground="{StaticResource NeonBrush}"/>
                </TextBlock>
                <TextBlock Text="This page intentionally has no buttons until the feature really works." Style="{StaticResource CaptionText}" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
