<UserControl x:Class="UniiziTweaker01.Views.ResolutionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageStyle}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,16">
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Resolution Manager" Style="{StaticResource TitleText}"/>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="Windows display settings" Command="{Binding OpenWindowsSettingsCommand}" Style="{StaticResource GhostButton}"/>
            </Grid>

            <!-- Keep / revert confirmation -->
            <Border Style="{StaticResource CardStyle}" BorderBrush="{StaticResource NeonBrush}" Margin="0,0,0,14"
                    Visibility="{Binding PendingConfirmation, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Keep these display settings?" Style="{StaticResource SectionText}"/>
                        <TextBlock Text="{Binding CountdownText}" Foreground="{StaticResource WarnBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Revert" Command="{Binding RevertCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0"/>
                        <Button Content="Keep changes" Command="{Binding KeepCommand}" Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Display" Style="{StaticResource SectionText}"/>
                    <ListBox ItemsSource="{Binding Displays}" SelectedItem="{Binding SelectedDisplay, Mode=TwoWay}"
                             Style="{StaticResource ChipListBox}" Margin="0,12,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding InfoText}" Style="{StaticResource CaptionText}" FontSize="12.5" LineHeight="20" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Resolution" Style="{StaticResource SectionText}"/>
                    <TextBlock Text="Only modes reported by Windows for this display. ★ = common preset supported by this display." Style="{StaticResource CaptionText}" Margin="0,4,0,12"/>
                    <ListBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption, Mode=TwoWay}" Style="{StaticResource ChipListBox}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Refresh rate" Style="{StaticResource SectionText}"/>
                    <ListBox ItemsSource="{Binding RefreshRates}" SelectedItem="{Binding SelectedRefreshRate, Mode=TwoWay}"
                             Style="{StaticResource ChipListBox}" Margin="0,12,0,4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat={}{0} Hz}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="Apply (with automatic revert)" Command="{Binding ApplyCommand}"
                            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Good to know" Style="{StaticResource SectionText}"/>
                    <TextBlock Text="{Binding GameVsDesktopNote}" Style="{StaticResource CaptionText}" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding SafetyNote}" Style="{StaticResource CaptionText}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
